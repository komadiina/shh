{
  "name": "shh",
  "version": "0.1.0",
  "description": "A keyboard-driven terminal UI for your SSH servers: sortable server table, YAML config, tmux-backed resumable sessions.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "shh": "./bin/shh"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "build": "bun build --compile --minify --define 'process.env.OPENTUI_LIBC=\"glibc\"' src/main.ts --outfile dist/shh",
    "check": "bun run typecheck && bun test",
    "build:musl": "bun build --compile --minify --target=bun-linux-x64-musl --define 'process.env.OPENTUI_LIBC=\"musl\"' src/main.ts --outfile dist/shh-musl"
  },
  "dependencies": {
    "@opentui/core": "^0.9.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
